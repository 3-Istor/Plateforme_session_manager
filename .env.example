# Application
APP_ENV=development
APP_SECRET=replace-with-a-long-random-value
DATABASE_URL=sqlite:///./worksession.db
FRONTEND_URL=http://localhost:5173

# Authentication: "demo" without Google, "google" for real OAuth in dev or production
AUTH_MODE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/calendar/callback
# Optional existing shared calendar. Leave empty to let the app create its own calendar.
GOOGLE_TARGET_CALENDAR_ID=

# The only account allowed to accept/refuse requests
MANAGER_EMAIL=manager@gmail.com

# Comma-separated fallback. This is the free/easy option for a team of six.
TEAM_MEMBERS=manager@gmail.com,membre@gmail.com

# Email notification. Leave empty to keep notifications in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
