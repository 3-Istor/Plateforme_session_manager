# Application
APP_ENV=development
APP_SECRET=replace-with-a-long-random-value
DATABASE_URL=sqlite:///./worksession.db
FRONTEND_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
SESSION_TTL_MINUTES=480

# Authentication: "demo" starts immediately; use "google" with the credentials below.
AUTH_MODE=demo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/calendar/callback
# Existing shared calendar in which every approved session is created.
GOOGLE_TARGET_CALENDAR_ID=913d31d1666fcfd7a8ad0c6447679a0ceafdbff55a20adb5a2dea1f655f39c92@group.calendar.google.com
# Optional read-only calendars whose busy periods block slots for the whole team.
# Separate multiple Calendar IDs with commas.
GOOGLE_AVAILABILITY_CALENDAR_IDS=

# The only account allowed to accept/refuse requests
MANAGER_EMAIL=joebejjani022@gmail.com

# Comma-separated fallback. This is the free/easy option for a team of six.
TEAM_MEMBERS=manager@gmail.com,membre@gmail.com

# Email notification. Leave empty to keep notifications in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional Discord notifications. Keep the full URL in Vault / Kubernetes Secret.
DISCORD_WEBHOOK_URL=
